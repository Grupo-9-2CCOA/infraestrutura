aws_region   = "us-east-1"
project_name = "doces-com-amor"

# AWS Academy denies an S3 API required by the Terraform AWS provider.
# Enable this only in an account where s3:GetBucketObjectLockConfiguration is allowed.
enable_data_lake = false

vpc_cidr              = "10.0.0.0/16"
public_subnet_a_cidr  = "10.0.1.0/24"
public_subnet_b_cidr  = "10.0.2.0/24"
backend_subnet_a_cidr = "10.0.3.0/24"
backend_subnet_b_cidr = "10.0.4.0/24"
database_subnet_cidr  = "10.0.5.0/24"

frontend_instance_type = "t3.micro"
backend_instance_type  = "t3.micro"
mysql_instance_type    = "t3.micro"

mysql_database = "doces_com_amor"
mysql_user     = "admin"
mysql_password = "ALTERAR_LOCALMENTE"

# By default, Terraform selects the most recently published ECR images.
# Optionally pin immutable images for rollback:
# backend_image_uri  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/doces-com-amor-backend:COMMIT_SHA"
# frontend_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/doces-com-amor-frontend:COMMIT_SHA"

# AWS Academy may prohibit IAM creation. In that case, use an existing profile:
# create_ec2_instance_profile = false
# ec2_instance_profile_name   = "LabInstanceProfile"

# Optional: SecretString must contain the Google service-account JSON.
# google_calendar_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:google-calendar"

# Optional: create the HTTPS listener with an already validated ACM certificate.
# alb_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/uuid"

# Optional: creates an email subscription that must be confirmed by the recipient.
# alarm_email = "alerts@example.com"
